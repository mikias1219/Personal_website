# Single canonical origin. Update when switching domains.
SITE_URL=https://mikiasabatesite.vercel.app

# Azure is selected when all three values exist. Deployment is your Azure deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Otherwise use Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Preferred: shared production limits. Without Redis, the approved temporary
# bounded per-instance limits reset on cold starts. Set REQUIRE_SHARED_RATE_LIMIT=1
# to disallow the temporary fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: set FROM to a verified sender. Without it, the resend.dev test sender
# can deliver only to the email address that owns your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Existing Vercel recipient override; defaults to the public portfolio email.
CONTACT_TO_EMAIL=

# Only for a loopback production preview; ignored on hosted Vercel deployments.
LOCAL_PREVIEW=

REQUIRE_SHARED_RATE_LIMIT=
