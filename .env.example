# Single canonical origin. Update when switching domains.
SITE_URL=https://mikiasabatesite.vercel.app

# Azure is selected when all three values exist. Deployment is your Azure deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Otherwise use Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required for production chat/contact rate limiting; local dev uses memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: FROM must use a verified sending domain. Recipient comes from profile.ts.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
